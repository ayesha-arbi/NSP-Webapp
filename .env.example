# ============================================================
# National Skills Passport (NSP) Webapp — Environment Configuration Template
# Copy this file to .env or .env.local for local overrides.
# ============================================================

# Local preview / development server port (default: 8443)
PORT=8443

# NSP Backend API Server URL (default: http://localhost:3000)
VITE_API_BASE_URL=http://localhost:3000

# Blockchain JSON-RPC Provider URL (default: http://127.0.0.1:8545)
VITE_RPC_URL=http://127.0.0.1:8545

# Deployed NSP Verifier Smart Contract Address (leave empty for simulated fallback mode)
VITE_VERIFIER_CONTRACT_ADDRESS=
